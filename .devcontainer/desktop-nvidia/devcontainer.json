{
  "name": "Desktop (NVIDIA GPU)",
  "dockerComposeFile": "compose.yaml",
  "service": "metro-lidar-processing",
  "workspaceFolder": "/home/dev/metro_ws/src/metro-lidar-processing",
  "remoteUser": "dev",
  "updateRemoteUserUID": false,
  "initializeCommand": "python3 \"${localWorkspaceFolder}/.devcontainer/scripts/x11_proxy.py\" start || echo \"X11 proxy unavailable; using Dev Containers GUI forwarding\"",
  "postCreateCommand": "bash scripts/build.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.analysis.extraPaths": [
          "/opt/ros/humble/local/lib/python3.10/dist-packages",
          "/opt/ros/humble/lib/python3.10/site-packages"
        ],
        "C_Cpp.default.compilerPath": "/usr/bin/g++",
        "C_Cpp.default.cppStandard": "c++17",
        "C_Cpp.default.includePath": ["${workspaceFolder}/**", "/opt/ros/humble/include/**"],
        "cmake.configureOnOpen": false
      }
    }
  }
}
