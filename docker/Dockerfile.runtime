FROM ros:humble-ros-base AS builder

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ws
COPY metro_perception_tools/package.xml /ws/src/metro_perception_tools/package.xml
COPY metro_perception_bringup/package.xml /ws/src/metro_perception_bringup/package.xml
COPY metro_perception_core/package.xml /ws/src/metro_perception_core/package.xml
COPY metro_perception_interfaces/package.xml /ws/src/metro_perception_interfaces/package.xml
COPY metro_perception_ros/package.xml /ws/src/metro_perception_ros/package.xml
RUN rosdep update --rosdistro humble \
    && apt-get update \
    && rosdep install --from-paths src --ignore-src --rosdistro humble \
       --dependency-types build --dependency-types buildtool --dependency-types exec -y \
    && rm -rf /var/lib/apt/lists/*

COPY metro_perception_tools /ws/src/metro_perception_tools
COPY metro_perception_bringup /ws/src/metro_perception_bringup
COPY metro_perception_core /ws/src/metro_perception_core
COPY metro_perception_interfaces /ws/src/metro_perception_interfaces
COPY metro_perception_ros /ws/src/metro_perception_ros
RUN /bin/bash -o pipefail -c 'source /opt/ros/humble/setup.bash \
    && colcon build --merge-install --cmake-args -DBUILD_TESTING=OFF \
    && rm -rf /ws/src /ws/build /ws/log'

FROM ros:humble-ros-base AS runtime

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    python3-numpy python3-scipy python3-matplotlib python3-opencv python3-yaml python3-pip \
    ros-humble-rclpy ros-humble-sensor-msgs \
    libyaml-cpp0.7 ros-humble-ament-index-cpp ros-humble-tf2-ros ros-humble-tf2 ros-humble-geometry-msgs \
    ros-humble-rclcpp ros-humble-vision-msgs ros-humble-visualization-msgs \
    ros-humble-rosidl-default-runtime ros-humble-rosbag2-cpp ros-humble-rosbag2-py \
    ros-humble-launch ros-humble-launch-ros \
    ros-humble-rosbag2 ros-humble-rosbag2-storage-default-plugins \
    ros-humble-rmw-cyclonedds-cpp \
    && apt-get purge -y python3-colcon-core python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

COPY docker/analysis-requirements.txt /tmp/analysis-requirements.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/analysis-requirements.txt \
    && rm /tmp/analysis-requirements.txt

WORKDIR /ws
COPY --from=builder /ws/install /opt/metro/install
COPY docker/gui-env.sh /etc/metro-gui-env.sh
COPY docker/runtime-entrypoint.sh /usr/local/bin/metro-entrypoint
RUN ln -s /opt/metro/install /ws/install \
    && chmod 0755 /usr/local/bin/metro-entrypoint \
    && groupadd --gid 1000 dev \
    && useradd --uid 1000 --gid 1000 --no-create-home --home-dir /tmp --shell /bin/bash dev \
    && echo 'dev ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/dev \
    && chmod 0440 /etc/sudoers.d/dev \
    && mkdir -p /data /results \
    && chmod 1777 /results

ENV ROS_DOMAIN_ID=42 \
    ROS_LOCALHOST_ONLY=1 \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    HOME=/tmp \
    ROS_LOG_DIR=/tmp/metro-ros-logs
USER 1000:1000
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/local/bin/metro-entrypoint"]
CMD ["bash"]

FROM runtime AS runtime-desktop
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository -y ppa:kisak/turtle \
    && apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-rviz2 libgl1-mesa-dri libglx-mesa0 \
    && rm -rf /var/lib/apt/lists/*
ENV QT_QPA_PLATFORM=xcb \
    QT_X11_NO_MITSHM=1 \
    LIBGL_ALWAYS_SOFTWARE=0
USER 1000:1000

FROM runtime AS default
