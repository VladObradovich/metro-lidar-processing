<?xml version="1.0"?>
<package format="3">
  <name>metro_perception_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and visualization configuration for Metro Perception.</description>
  <maintainer email="vladislav.icgod@gmail.com">VladObradovich</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>metro_perception_tools</exec_depend>
  <exec_depend>metro_perception_ros</exec_depend>
  <!-- RViz panel of rviz/detector.rviz (rviz:=true). -->
  <exec_depend>metro_perception_rviz</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
